# ==========================================
# CẤU HÌNH MÔI TRƯỜNG VẬN HÀNH THỰC TẾ (PRODUCTION)
# ==========================================

# 1. Cấu hình Chung & Cổng ứng dụng
NODE_ENV=production
PORT=3000

# 2. Cơ sở dữ liệu PostgreSQL thực tế
# Điền thông tin Host, Port, Database Name, User, và Password của Prod Database tại đây
DATABASE_URL="postgresql://<YOUR_PROD_DB_USER>:<YOUR_PROD_DB_PASSWORD>@<YOUR_PROD_DB_HOST>:<YOUR_PROD_DB_PORT>/<YOUR_PROD_DB_NAME>?schema=public&sslmode=require"

# 3. Bảo mật & Xác thực JWT
# HƯỚNG DẪN TẠO CHUỖI BĂM BẢO MẬT 64 KÝ TỰ (JWT_SECRET):
# Chạy lệnh sau trong Terminal của bạn để tạo khóa ngẫu nhiên, an toàn cao:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sao chép chuỗi kết quả nhận được và dán vào biến JWT_SECRET dưới đây.
JWT_SECRET="<PASTE_YOUR_GENERATED_64_CHAR_HEX_HERE>"
JWT_EXPIRES_IN="1d"
REFRESH_SESSION_EXPIRY_DAYS="7"
BCRYPT_SALT_ROUNDS="12"

# 4. Hạn ngạch & Vòng đời Lời mời tham gia Dự án
INVITATION_EXPIRY_DAYS="7"

# 5. Cấu hình Redis thực tế
# Cấu hình cụm Redis dùng cho Gateway Socket.io chạy phân tán/cluster trên production
REDIS_HOST="<YOUR_PROD_REDIS_HOST>"
REDIS_PORT=6379
REDIS_PASSWORD="<YOUR_PROD_REDIS_PASSWORD>"

# 6. Cấu hình CORS thực tế
# CHỈ ĐỊNH RÕ MIỀN CHẤP NHẬN: Thay đổi thành domain production thực tế của client, không được sử dụng "*"
CORS_ORIGINS="https://myproject.com,https://api.myproject.com"
