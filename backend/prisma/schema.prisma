generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ================= ENUMS =================
enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssignmentRole {
  LEAD
  CONTRIBUTOR
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum NotificationType {
  MENTION
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ANNOUNCEMENT
}

// ================= MODELS =================
model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  name             String?
  role             Role             @default(MEMBER)

  memberships      ProjectMember[]  @relation("UserToMember")
  invitedMembers   ProjectMember[]  @relation("InvitedMembers")
  assignedTasks    TaskAssignment[]
  createdTaskAssignments TaskAssignment[] @relation("TaskAssignmentsCreatedBy")
  taskReports      TaskReport[]
  sentInvites      Invitation[]     @relation("Sender")
  messages         Message[]
  comments         Comment[]
  notifications    Notification[]   @relation("UserNotifications")
  sessions         AuthSession[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Project {
  id               Int              @id @default(autoincrement())
  name             String
  description      String?

  members          ProjectMember[]
  tasks            Task[]
  invitations      Invitation[]
  messages         Message[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([createdAt])
}

model ProjectMember {
  id               Int              @id @default(autoincrement())
  role             ProjectRole      @default(MEMBER)

  userId           Int
  user             User             @relation("UserToMember", fields: [userId], references: [id], onDelete: Cascade)

  projectId        Int
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invitedById      Int?
  invitedBy        User?            @relation("InvitedMembers", fields: [invitedById], references: [id], onDelete: SetNull)

  joinedAt         DateTime         @default(now())
  leftAt           DateTime?

  @@unique([userId, projectId])
  @@index([projectId, leftAt])
  @@index([userId, leftAt])
  @@index([projectId, role, leftAt])
}

model Task {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  status           TaskStatus       @default(TODO)
  priority         TaskPriority     @default(MEDIUM)
  version          Int              @default(0)

  projectId        Int
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignments      TaskAssignment[]
  reports          TaskReport[]
  comments         Comment[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model TaskAssignment {
  id               Int                @id @default(autoincrement())
  role             TaskAssignmentRole @default(CONTRIBUTOR)

  userId           Int
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId           Int
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assignedById     Int?
  assignedBy       User?              @relation("TaskAssignmentsCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt       DateTime           @default(now())

  @@unique([userId, taskId])
  @@index([taskId, role])
  @@index([userId])
  @@index([assignedById])
  @@index([assignedAt])
}

model TaskReport {
  id               Int              @id @default(autoincrement())
  content          String           @db.Text
  attachments      String[]
  status           ReportStatus     @default(PENDING)
  feedback         String?          @db.Text

  taskId           Int
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId         Int
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([taskId, status])
  @@index([authorId])
  @@index([createdAt])
}

model Invitation {
  id               Int              @id @default(autoincrement())
  email            String
  tokenHash        String           @unique @map("token")
  tokenPreview     String?
  status           InvitationStatus @default(PENDING)
  role             ProjectRole      @default(MEMBER)

  projectId        Int
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  senderId         Int
  sender           User             @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)

  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  sentAt           DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([projectId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([projectId, email, status])
  @@index([projectId, role, status])
}

model AuthSession {
  id               Int       @id @default(autoincrement())

  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userAgent        String?
  ipAddress        String?

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}

model Message {
  id               Int              @id @default(autoincrement())
  content          String           @db.Text

  senderId         Int?
  sender           User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)

  projectId        Int
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  isSystem         Boolean          @default(false)
  isImportant      Boolean          @default(false)
  isAnnouncement   Boolean          @default(false)

  metadata         Json?
  createdAt        DateTime         @default(now())

  notifications    Notification[]   @relation("MessageNotifications")

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([senderId])
  @@index([isSystem, createdAt])
}

model Notification {
  id               Int              @id @default(autoincrement())

  recipientId      Int
  recipient        User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  activityId       Int
  activity         Message          @relation("MessageNotifications", fields: [activityId], references: [id], onDelete: Cascade)

  isRead           Boolean          @default(false)
  readAt           DateTime?
  type             NotificationType
  createdAt        DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([activityId])
  @@index([type])
  @@unique([recipientId, activityId, type])
}

model Comment {
  id          Int      @id @default(autoincrement())
  content     String   @db.Text
  attachments String[]

  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId    Int
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}
