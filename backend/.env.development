# ==========================================
# CẤU HÌNH MÔI TRƯỜNG PHÁT TRIỂN (DEVELOPMENT)
# ==========================================

# 1. Cấu hình Chung & Cổng ứng dụng (App Config)
NODE_ENV=development
PORT=3000

# 2. Cơ sở dữ liệu PostgreSQL (Database Config)
# Sử dụng PostgreSQL trên localhost với tài khoản mặc định và db là project_dev
POSTGRES_DB=realtime_pm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# 3. Bảo mật & Xác thực JWT (Security & Auth Config)
# Secret key đơn giản dùng để ký mã JWT và refresh session ở môi trường local
JWT_SECRET="dev-super-secret-key-123456"
JWT_EXPIRES_IN="1d"
REFRESH_SESSION_EXPIRY_DAYS="7"
BCRYPT_SALT_ROUNDS="12"

# 4. Hạn ngạch & Vòng đời Lời mời tham gia Dự án
INVITATION_EXPIRY_DAYS="7"

# 5. Cấu hình Redis (Redis Config)
# Trỏ về Redis chạy local dùng cho Realtime Socket.io Adapter & Gateway
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# 6. Cấu hình CORS (CORS Configuration)
# Chỉ chấp nhận request từ localhost của Client (React/Vite) trong quá trình dev
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
