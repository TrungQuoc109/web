# ==========================================
# CẤU HÌNH MÔI TRƯỜNG PHÁT TRIỂN - FRONTEND (DEVELOPMENT)
# ==========================================

# 1. Đường dẫn kết nối API Backend
# Trỏ trực tiếp đến cổng NestJS dev server đang chạy local
VITE_API_URL="http://localhost:3000"

# 2. Cấu hình Tiện ích nhà phát triển (Developer Utilities)
# Tự động điền tài khoản mật khẩu và đăng nhập nhanh khi reload trang (1: Bật, 0: Tắt)
VITE_AUTO_LOGIN="1"

# 3. Cấu hình Mock Data trống (Để kiểm tra giao diện Empty State)
# Đặt bằng 1 để giả lập danh sách trống cho từng màn hình, đặt bằng 0 để dùng dữ liệu bình thường
VITE_DASHBOARD_EMPTY="0"
VITE_PROJECTS_EMPTY="0"
VITE_TASKS_EMPTY="0"
VITE_MEMBERS_EMPTY="0"
VITE_NOTIFICATIONS_EMPTY="0"
VITE_MESSAGES_EMPTY="0"
