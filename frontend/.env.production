# ==========================================
# CẤU HÌNH MÔI TRƯỜNG VẬN HÀNH THỰC TẾ - FRONTEND (PRODUCTION)
# ==========================================

# 1. Đường dẫn kết nối API Backend thực tế
# Điền domain chính thức của API Backend (NestJS Server) trên production
VITE_API_URL="https://api.myproject.com"

# 2. Cấu hình Tiện ích nhà phát triển
# Luôn luôn TẮT tính năng tự động đăng nhập ở môi trường production vì lý do bảo mật
VITE_AUTO_LOGIN="0"

# 3. Cấu hình Mock Data trống
# Đặt tất cả về 0 để chạy trực tiếp trên luồng dữ liệu thực tế từ Database
VITE_DASHBOARD_EMPTY="0"
VITE_PROJECTS_EMPTY="0"
VITE_TASKS_EMPTY="0"
VITE_MEMBERS_EMPTY="0"
VITE_NOTIFICATIONS_EMPTY="0"
VITE_MESSAGES_EMPTY="0"
